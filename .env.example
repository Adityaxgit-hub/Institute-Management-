# Database Configuration
DB_HOST=localhost              # The hostname of the database server (e.g., localhost, 127.0.0.1)
DB_USER=root                   # The username to connect to the database
DB_PASSWORD=your_db_password   # The password for the database user
DB_NAME=institute_db           # The name of the database schema

# Session Security
SESSION_SECRET=your_session_secret  # Secret string used to sign session cookies. Change this to a secure random string in production.

# Email Service (Nodemailer Gmail SMTP)
GMAIL_USER=your_email@gmail.com              # The Gmail account address used to send verification and password reset emails
GMAIL_APP_PASSWORD=your_gmail_app_password   # Google App Password generated for secure SMTP access (not your account password)

# Application Settings
APP_BASE_URL=http://localhost:5000  # The base URL of the front-end application
PORT=5000                           # The port on which the Express server listens

# Environment Mode
NODE_ENV=development                # Environment mode ('development', 'production', or 'test')
