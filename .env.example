# Database Configuration
DB_HOST=localhost              # The hostname of the database server (e.g., localhost, 127.0.0.1)
DB_USER=root                   # The username to connect to the database
DB_PASSWORD=your_db_password   # The password for the database user
DB_NAME=institute_db           # The name of the database schema
DB_PORT=3306                  

# Session Security
SESSION_SECRET=your_session_secret

SENDGRID_API_KEY=your_sendgrid_api_key_here 
SENDGRID_FROM_EMAIL=noreply@yourdomain.com    

APP_BASE_URL=http://localhost:5000 
PORT=5000                          

# Environment Mode
NODE_ENV=production

# Backblaze B2 Configuration
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET=your-bucket-name
