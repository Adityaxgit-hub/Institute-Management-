{
  "name": "institute-portal",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "csp:build": "node scripts/generate-csp-hashes.js",
    "prepare": "node -e \"if (process.env.NODE_ENV !== 'production' && !process.env.CI) process.exit(0); else process.exit(0);\""
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/tests/env.setup.js"
    ],
    "testTimeout": 15000
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "file-type": "^22.0.1",
    "helmet": "^8.2.0",
    "multer": "^2.2.0",
    "multer-s3": "^3.0.1",
    "mysql2": "^3.22.5",
    "nodemailer": "^9.0.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.8",
    "supertest": "^7.2.2"
  },
  "lint-staged": {
    "public/**/*.html": [
      "npm run csp:build",
      "git add csp-hashes.json"
    ]
  }
